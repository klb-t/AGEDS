{
  "schema": "ageds.importplan-detectors",
  "version": "2",
  "changes": {"2": "2026-10-30: WhatsApp chat names in NL/PL/FR/ES/PT wording; bidi marks before a chat line; a .eml starting with an mbox From line goes to email_eml"},
  "notice": "Detection rules are data. Name patterns and structure markers follow publicly observed export layouts (ChatGPT, Claude.ai, Google Takeout, SMS Backup & Restore, WhatsApp, call recorders). They are examples, not claims about every app or export version. A rule only proposes an importer; nothing is imported until a person approves the plan item.",
  "probe": {
    "prefix_bytes": 65536,
    "basis": "bounded prefix read of the catalogued bytes; markers are heuristics, never a full parse"
  },
  "contexts": [
    {"id": "google_takeout", "locator_regex": "(^|/|!/)Takeout/", "marker_name_regex": "archive_browser\\.html"}
  ],
  "chat_exports": {
    "conversation_name_regex": "conversations(?:-\\d+)?\\.json",
    "vendors": [
      {"importer": "chatgpt_export", "mapping": "chatgpt",
       "element_key_markers": ["mapping", "current_node"],
       "companion_name_regex": "(?:user\\.json|message_feedback\\.json|chat\\.html|shared_conversations\\.json|model_comparisons\\.json|file[-_].+)"},
      {"importer": "claude_export", "mapping": "claude",
       "element_key_markers": ["chat_messages"],
       "companion_name_regex": "(?:users\\.json|projects\\.json)"}
    ]
  },
  "whatsapp": {
    "chat_name_regex": "(?:WhatsApp[ -]Chat (?:with|met|z|mit|avec|con|com) .+|WhatsApp Chat - .+|(?:Czat|Chat|Chat de|Discussion|Conversa do) WhatsApp (?:z|con|avec|com) .+|_chat)\\.txt",
    "chat_name_examples": ["WhatsApp Chat with X.txt (EN Android)", "WhatsApp-chat met X.txt (NL Android)", "Czat WhatsApp z X.txt (PL Android)", "WhatsApp Chat mit X.txt (DE Android)", "_chat.txt (iOS)"],
    "line_regex": "^[\\u200e\\u200f\\ufeff]*\\[?\\d{1,4}[./-]\\d{1,2}[./-]\\d{1,4},? \\d{1,2}[:.]\\d{2}",
    "min_matching_lines": 1
  },
  "files": [
    {"id": "mbox", "types": ["mbox"], "locator_not_regex": "(?i)\\.eml(?:!\\d+)?$",
     "candidates": [{"importer": "email_mbox", "reason": "catalog byte signature: mbox (From line followed by headers)"}]},
    {"id": "eml_with_mbox_from_line", "types": ["mbox"], "locator_regex": "(?i)\\.eml(?:!\\d+)?$",
     "candidates": [
       {"importer": "email_eml", "reason": "a .eml file that starts with an mbox \"From \" line (e.g. Thunderbird \"Save as\"); one message"},
       {"importer": "email_mbox", "preference": "alternative", "reason": "the same bytes read as a one-message mbox"}]},
    {"id": "eml", "types": ["eml"],
     "candidates": [{"importer": "email_eml", "reason": "catalog byte signature: RFC 822 header block"}]},
    {"id": "ics", "types": ["ics"],
     "candidates": [{"importer": "ics", "reason": "catalog byte signature: iCalendar"}]},
    {"id": "vcf", "types": ["vcf"],
     "candidates": [{"importer": "vcf", "reason": "catalog byte signature: vCard"}]},
    {"id": "calls_xml", "types": ["xml"], "probe": {"kind": "xml_root", "equals": ["calls"]},
     "candidates": [
       {"importer": "calls_xml", "reason": "XML root element <calls> (SMS Backup & Restore call log)"},
       {"importer": "sms_backup", "preference": "alternative", "reason": "the older SMS Backup importer also reads <calls>; a second projection of the same file"}]},
    {"id": "sms_xml", "types": ["xml"], "probe": {"kind": "xml_root", "equals": ["smses"]},
     "candidates": [{"importer": "sms_backup", "reason": "XML root element <smses> (SMS Backup & Restore)"}]},
    {"id": "chrome_browser_history", "types": ["json"], "probe": {"kind": "json_keys", "top": "object", "any": ["Browser History"]},
     "candidates": [{"importer": "browser_history", "reason": "JSON object with a \"Browser History\" list (Takeout Chrome)"}]},
    {"id": "location_records", "types": ["json"], "probe": {"kind": "json_keys", "top": "object", "any": ["locations"], "all_text": ["latitudeE7"]},
     "candidates": [{"importer": "location_history", "reason": "JSON object with \"locations\" points (Takeout Location History Records.json)"}]},
    {"id": "location_semantic", "types": ["json"], "probe": {"kind": "json_keys", "top": "object", "any": ["timelineObjects"]},
     "candidates": [{"importer": "location_history", "reason": "JSON object with \"timelineObjects\" (Semantic Location History)"}]},
    {"id": "location_timeline", "types": ["json"], "probe": {"kind": "json_keys", "top": "object", "any": ["semanticSegments"]},
     "candidates": [{"importer": "location_history", "reason": "JSON object with \"semanticSegments\" (on-device Timeline export)"}]},
    {"id": "my_activity_browsing_json", "types": ["json"],
     "locator_regex": "(?:^|/)(?:My Activity/(?:Chrome|YouTube|YouTube Music)/|YouTube and YouTube Music/history/)",
     "probe": {"kind": "json_keys", "top": "array", "any": ["header", "titleUrl", "time"]},
     "candidates": [{"importer": "browser_history", "reason": "My Activity records in a Chrome/YouTube folder (browsing-like history)"}]},
    {"id": "my_activity_json", "types": ["json"], "locator_regex": "(?:^|/)My Activity/",
     "locator_not_regex": "(?:^|/)My Activity/(?:Chrome|YouTube|YouTube Music)/",
     "probe": {"kind": "json_keys", "top": "array", "any": ["header", "products"]},
     "candidates": [{"importer": "takeout_activity", "reason": "JSON list of My Activity records under a My Activity folder"}]},
    {"id": "my_activity_browsing_html", "types": ["html"],
     "locator_regex": "(?:^|/)(?:My Activity/(?:Chrome|YouTube|YouTube Music)/|YouTube and YouTube Music/history/)",
     "probe": {"kind": "text_markers", "all": ["outer-cell"]},
     "candidates": [{"importer": "browser_history", "reason": "My Activity HTML in a Chrome/YouTube folder (browsing-like history)"}]},
    {"id": "my_activity_html", "types": ["html"],
     "locator_not_regex": "(?:^|/)(?:My Activity/(?:Chrome|YouTube|YouTube Music)/|YouTube and YouTube Music/history/)",
     "probe": {"kind": "text_markers", "all": ["outer-cell"]},
     "candidates": [{"importer": "takeout_activity", "reason": "HTML with My Activity outer-cell records"}]},
    {"id": "billing_table", "types": ["csv", "tsv", "xlsx"], "probe": {"kind": "billing_header"},
     "candidates": [{"importer": "billing", "reason": "table header matches a billing profile; an explicit profile is required before approval"}]},
    {"id": "recording_name", "types": ["wav", "mp3", "aac", "m4a", "m4b", "ogg", "opus", "flac", "amr", "3gp", "mp4", "isobmff", "webm"],
     "probe": {"kind": "recording_name"},
     "candidates": [{"importer": "recording_names", "reason": "file name matches a call-recorder name pattern (hypothesis source only)"}]},
    {"id": "image_exif", "types": ["jpg", "tiff", "png"], "probe": {"kind": "exif_marker"},
     "candidates": [{"importer": "exif", "reason": "embedded EXIF block present in the prefix"}]}
  ]
}
