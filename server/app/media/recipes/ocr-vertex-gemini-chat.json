{
  "schema": "ageds.media_recipe",
  "schema_version": 1,
  "id": "ocr-vertex-gemini-chat",
  "kind": "ocr",
  "revision": 1,
  "description": "Chat screenshot OCR by Gemini on Vertex AI: lines plus message candidates (sender, time and text exactly as shown, bubble side). Candidates are never events.",
  "engine": "vertex-gemini:gemini-3.5-flash@global",
  "languages": [
    "pol",
    "nld",
    "eng"
  ],
  "psm": null,
  "oem": null,
  "layout": "chat_screenshot",
  "pdf": {
    "rasterizer": "text_layer_then_model",
    "dpi": null,
    "max_pages": 50
  },
  "limits": {
    "max_input_bytes": 15000000,
    "max_page_image_bytes": 15000000,
    "timeout_s": 600,
    "max_words": 2000000
  }
}
