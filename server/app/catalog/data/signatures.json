{
  "schema": "ageds.catalog-signatures/v1",
  "version": "2026-10-16.1",
  "notes": "Byte signatures win over extensions. Rules are evaluated in order; the first match wins. Text rules are heuristics and are labelled as such. Extensions only declare what a name claims.",
  "types": {
    "wav": {"family": "audio", "mime": "audio/wav", "extensions": ["wav", "wave"]},
    "mp3": {"family": "audio", "mime": "audio/mpeg", "extensions": ["mp3"]},
    "aac": {"family": "audio", "mime": "audio/aac", "extensions": ["aac"]},
    "m4a": {"family": "audio", "mime": "audio/mp4", "extensions": ["m4a"]},
    "m4b": {"family": "audio", "mime": "audio/mp4", "extensions": ["m4b"]},
    "ogg": {"family": "audio", "mime": "audio/ogg", "extensions": ["ogg", "oga"]},
    "opus": {"family": "audio", "mime": "audio/ogg; codecs=opus", "extensions": ["opus"]},
    "flac": {"family": "audio", "mime": "audio/flac", "extensions": ["flac"]},
    "amr": {"family": "audio", "mime": "audio/amr", "extensions": ["amr", "awb"]},
    "mp4": {"family": "video", "mime": "video/mp4", "extensions": ["mp4"]},
    "m4v": {"family": "video", "mime": "video/x-m4v", "extensions": ["m4v"]},
    "mov": {"family": "video", "mime": "video/quicktime", "extensions": ["mov", "qt"]},
    "3gp": {"family": "video", "mime": "video/3gpp", "extensions": ["3gp", "3gpp"]},
    "3g2": {"family": "video", "mime": "video/3gpp2", "extensions": ["3g2"]},
    "isobmff": {"family": "video", "mime": "application/mp4", "extensions": []},
    "mkv": {"family": "video", "mime": "video/x-matroska", "extensions": ["mkv", "mka"]},
    "webm": {"family": "video", "mime": "video/webm", "extensions": ["webm"]},
    "avi": {"family": "video", "mime": "video/x-msvideo", "extensions": ["avi"]},
    "jpg": {"family": "image", "mime": "image/jpeg", "extensions": ["jpg", "jpeg", "jpe", "jfif"]},
    "png": {"family": "image", "mime": "image/png", "extensions": ["png"]},
    "gif": {"family": "image", "mime": "image/gif", "extensions": ["gif"]},
    "webp": {"family": "image", "mime": "image/webp", "extensions": ["webp"]},
    "heic": {"family": "image", "mime": "image/heic", "extensions": ["heic"]},
    "heif": {"family": "image", "mime": "image/heif", "extensions": ["heif", "hif"]},
    "avif": {"family": "image", "mime": "image/avif", "extensions": ["avif"]},
    "tiff": {"family": "image", "mime": "image/tiff", "extensions": ["tif", "tiff", "dng"]},
    "pdf": {"family": "document", "mime": "application/pdf", "extensions": ["pdf"]},
    "docx": {"family": "document", "mime": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "extensions": ["docx", "docm", "dotx"]},
    "xlsx": {"family": "spreadsheet", "mime": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "extensions": ["xlsx", "xlsm", "xltx"]},
    "pptx": {"family": "document", "mime": "application/vnd.openxmlformats-officedocument.presentationml.presentation", "extensions": ["pptx", "pptm"]},
    "odt": {"family": "document", "mime": "application/vnd.oasis.opendocument.text", "extensions": ["odt"]},
    "ods": {"family": "spreadsheet", "mime": "application/vnd.oasis.opendocument.spreadsheet", "extensions": ["ods"]},
    "odp": {"family": "document", "mime": "application/vnd.oasis.opendocument.presentation", "extensions": ["odp"]},
    "epub": {"family": "document", "mime": "application/epub+zip", "extensions": ["epub"]},
    "apk": {"family": "package", "mime": "application/vnd.android.package-archive", "extensions": ["apk"]},
    "xls": {"family": "spreadsheet", "mime": "application/vnd.ms-excel", "extensions": ["xls"]},
    "doc": {"family": "document", "mime": "application/msword", "extensions": ["doc"]},
    "ppt": {"family": "document", "mime": "application/vnd.ms-powerpoint", "extensions": ["ppt"]},
    "msg": {"family": "email", "mime": "application/vnd.ms-outlook", "extensions": ["msg"]},
    "ole_cfb": {"family": "document", "mime": "application/x-cfb", "extensions": []},
    "zip": {"family": "archive", "mime": "application/zip", "extensions": ["zip"]},
    "tar": {"family": "archive", "mime": "application/x-tar", "extensions": ["tar"]},
    "tar.gz": {"family": "archive", "mime": "application/gzip", "extensions": ["tar.gz", "tgz"]},
    "tar.bz2": {"family": "archive", "mime": "application/x-bzip2", "extensions": ["tar.bz2", "tbz", "tbz2"]},
    "tar.xz": {"family": "archive", "mime": "application/x-xz", "extensions": ["tar.xz", "txz"]},
    "gz": {"family": "archive", "mime": "application/gzip", "extensions": ["gz"]},
    "bz2": {"family": "archive", "mime": "application/x-bzip2", "extensions": ["bz2"]},
    "xz": {"family": "archive", "mime": "application/x-xz", "extensions": ["xz"]},
    "7z": {"family": "archive", "mime": "application/x-7z-compressed", "extensions": ["7z"]},
    "rar": {"family": "archive", "mime": "application/vnd.rar", "extensions": ["rar"]},
    "sqlite": {"family": "database", "mime": "application/vnd.sqlite3", "extensions": ["sqlite", "sqlite3", "db"]},
    "json": {"family": "text", "mime": "application/json", "extensions": ["json"]},
    "jsonl": {"family": "text", "mime": "application/x-ndjson", "extensions": ["jsonl", "ndjson"]},
    "html": {"family": "text", "mime": "text/html", "extensions": ["html", "htm", "xhtml"]},
    "xml": {"family": "text", "mime": "application/xml", "extensions": ["xml"]},
    "svg": {"family": "image", "mime": "image/svg+xml", "extensions": ["svg"]},
    "mbox": {"family": "email", "mime": "application/mbox", "extensions": ["mbox", "mbx"]},
    "eml": {"family": "email", "mime": "message/rfc822", "extensions": ["eml"]},
    "vcf": {"family": "contact", "mime": "text/vcard", "extensions": ["vcf", "vcard"]},
    "ics": {"family": "calendar", "mime": "text/calendar", "extensions": ["ics", "ical"]},
    "csv": {"family": "text", "mime": "text/csv", "extensions": ["csv"]},
    "tsv": {"family": "text", "mime": "text/tab-separated-values", "extensions": ["tsv", "tab"]},
    "txt": {"family": "text", "mime": "text/plain", "extensions": ["txt", "text", "log", "md", "nfo", "ini", "cfg", "conf", "yaml", "yml"]}
  },
  "opaque_extensions": ["dat", "bin", "tmp", "part", "crdownload", "bak", "raw", "dump", "data"],
  "compatible_groups": [
    ["isobmff", "mp4", "m4a", "m4b", "m4v", "mov", "3gp", "3g2"],
    ["ogg", "opus"],
    ["mkv", "webm"],
    ["heic", "heif", "avif"],
    ["mp3", "aac"],
    ["xml", "svg", "html"],
    ["json", "jsonl"],
    ["gz", "tar.gz"],
    ["bz2", "tar.bz2"],
    ["xz", "tar.xz"],
    ["zip", "docx", "xlsx", "pptx", "odt", "ods", "odp", "epub", "apk"],
    ["ole_cfb", "xls", "doc", "ppt", "msg"]
  ],
  "rules": [
    {"id": "pdf", "type": "pdf", "all": [{"at": 0, "ascii": "%PDF-"}]},
    {"id": "png", "type": "png", "all": [{"at": 0, "hex": "89504e470d0a1a0a"}]},
    {"id": "jpeg", "type": "jpg", "all": [{"at": 0, "hex": "ffd8ff"}]},
    {"id": "gif", "type": "gif", "any": [{"at": 0, "ascii": "GIF87a"}, {"at": 0, "ascii": "GIF89a"}]},
    {"id": "riff_wave", "type": "wav", "all": [{"at": 0, "ascii": "RIFF"}, {"at": 8, "ascii": "WAVE"}]},
    {"id": "rf64_wave", "type": "wav", "all": [{"at": 0, "ascii": "RF64"}, {"at": 8, "ascii": "WAVE"}]},
    {"id": "riff_webp", "type": "webp", "all": [{"at": 0, "ascii": "RIFF"}, {"at": 8, "ascii": "WEBP"}]},
    {"id": "riff_avi", "type": "avi", "all": [{"at": 0, "ascii": "RIFF"}, {"at": 8, "ascii": "AVI "}]},
    {"id": "isobmff_ftyp", "type": "isobmff", "all": [{"at": 4, "ascii": "ftyp"}], "refine": "ftyp_brand"},
    {"id": "ogg", "type": "ogg", "all": [{"at": 0, "ascii": "OggS"}], "refine": "ogg_codec"},
    {"id": "flac", "type": "flac", "all": [{"at": 0, "ascii": "fLaC"}]},
    {"id": "amr_nb", "type": "amr", "all": [{"at": 0, "ascii": "#!AMR\n"}]},
    {"id": "amr_wb", "type": "amr", "all": [{"at": 0, "ascii": "#!AMR-WB\n"}]},
    {"id": "ebml", "type": "mkv", "all": [{"at": 0, "hex": "1a45dfa3"}], "refine": "ebml_doctype"},
    {"id": "id3", "type": "mp3", "all": [{"at": 0, "ascii": "ID3"}], "refine": "id3_payload"},
    {"id": "zip_local", "type": "zip", "all": [{"at": 0, "hex": "504b0304"}], "refine": "zip_members"},
    {"id": "zip_empty", "type": "zip", "all": [{"at": 0, "hex": "504b0506"}]},
    {"id": "zip_spanned", "type": "zip", "all": [{"at": 0, "hex": "504b0708"}], "refine": "zip_members"},
    {"id": "gzip", "type": "gz", "all": [{"at": 0, "hex": "1f8b08"}]},
    {"id": "bzip2", "type": "bz2", "all": [{"at": 0, "ascii": "BZh"}, {"at": 4, "hex": "314159265359"}]},
    {"id": "xz", "type": "xz", "all": [{"at": 0, "hex": "fd377a585a00"}]},
    {"id": "7z", "type": "7z", "all": [{"at": 0, "hex": "377abcaf271c"}]},
    {"id": "rar5", "type": "rar", "all": [{"at": 0, "hex": "526172211a070100"}]},
    {"id": "rar4", "type": "rar", "all": [{"at": 0, "hex": "526172211a0700"}]},
    {"id": "tar_ustar", "type": "tar", "all": [{"at": 257, "ascii": "ustar"}]},
    {"id": "ole_cfb", "type": "ole_cfb", "all": [{"at": 0, "hex": "d0cf11e0a1b11ae1"}], "refine": "cfb_directory"},
    {"id": "sqlite3", "type": "sqlite", "all": [{"at": 0, "hex": "53514c69746520666f726d6174203300"}]},
    {"id": "tiff_le", "type": "tiff", "all": [{"at": 0, "hex": "49492a00"}]},
    {"id": "tiff_be", "type": "tiff", "all": [{"at": 0, "hex": "4d4d002a"}]},
    {"id": "pdf_late_header", "type": "pdf", "search": {"ascii": "%PDF-", "within": 1024}},
    {"id": "mpeg_audio_frame", "type": "mp3", "frame_sync": true}
  ],
  "ftyp_brands": {
    "isom": "mp4", "iso2": "mp4", "iso4": "mp4", "iso5": "mp4", "iso6": "mp4", "mp41": "mp4", "mp42": "mp4",
    "avc1": "mp4", "dash": "mp4", "mmp4": "mp4", "MSNV": "mp4", "f4v ": "mp4",
    "M4A ": "m4a", "M4B ": "m4b", "M4P ": "m4a", "M4V ": "m4v", "M4VH": "m4v", "M4VP": "m4v",
    "qt  ": "mov",
    "3gp4": "3gp", "3gp5": "3gp", "3gp6": "3gp", "3gp7": "3gp", "3gs7": "3gp", "3ge6": "3gp", "3ge7": "3gp", "3gg6": "3gp",
    "3g2a": "3g2", "3g2b": "3g2", "3g2c": "3g2",
    "heic": "heic", "heix": "heic", "heim": "heic", "heis": "heic", "hevc": "heic", "hevx": "heic",
    "mif1": "heif", "msf1": "heif", "avif": "avif", "avis": "avif"
  },
  "ebml_doctypes": {"webm": "webm", "matroska": "mkv"},
  "ogg_codecs": [
    {"type": "opus", "at": 28, "ascii": "OpusHead"},
    {"type": "ogg", "at": 28, "hex": "01766f72626973"},
    {"type": "flac", "at": 28, "ascii": "\u007fFLAC"}
  ],
  "zip_member_rules": [
    {"type": "docx", "requires": ["[Content_Types].xml"], "any_prefix": ["word/"]},
    {"type": "xlsx", "requires": ["[Content_Types].xml"], "any_prefix": ["xl/"]},
    {"type": "pptx", "requires": ["[Content_Types].xml"], "any_prefix": ["ppt/"]},
    {"type": "odt", "mimetype": "application/vnd.oasis.opendocument.text"},
    {"type": "ods", "mimetype": "application/vnd.oasis.opendocument.spreadsheet"},
    {"type": "odp", "mimetype": "application/vnd.oasis.opendocument.presentation"},
    {"type": "epub", "mimetype": "application/epub+zip"},
    {"type": "apk", "requires": ["AndroidManifest.xml", "classes.dex"]}
  ],
  "cfb_streams": [
    {"type": "xls", "names": ["Workbook", "Book"]},
    {"type": "doc", "names": ["WordDocument"]},
    {"type": "ppt", "names": ["PowerPoint Document"]},
    {"type": "msg", "name_prefix": "__substg1.0_"}
  ],
  "text": {
    "max_control_ratio": 0.05,
    "email_headers": ["from", "to", "cc", "subject", "date", "message-id", "received", "mime-version", "return-path", "reply-to", "content-type", "delivered-to"],
    "min_email_headers": 2,
    "delimiter_lines": 5
  }
}
